# Copy to .env and edit. .env is gitignored and must stay that way: it is the
# only file in this repository that is expected to hold a credential.
#
# Nothing here is required. NAVIS runs fully on the deterministic path with no
# .env file at all, and that is what the demo runs.

# Extraction provider. Default is rules-only: the deterministic regex
# pre-pass with no LLM. The LLM path is strictly opt-in.
#   rules   - regex pre-pass only (default; no LLM, no network)
#   ollama  - local Ollama, grammar-constrained structured output
#   openai  - any OpenAI-compatible endpoint
EXTRACTION_PROVIDER=rules

# ── What the LLM is and is not allowed to do ─────────────────────────────────
# Turning this on adds an interpreter, not a decision-maker. Whichever provider
# is selected, the model may only propose a discipline, a status and a one-line
# description, and every one of those is re-validated deterministically before
# it is used: the discipline must be in our closed vocabulary, the status is
# re-parsed by our own parser, and the description must be grounded in the
# supervisor's own words (see D-065).
#
# It can never pick an activity id, produce a confidence, supply a tag (D-006),
# supply a date, or write anything to the schedule. Those come from the
# matching engine and from the Planning Engineer's confirmation.
#
# Check what is actually live at any time:
#     curl.exe http://127.0.0.1:8000/agent/llm-status
# That route reports whether the path is on, which provider is configured,
# whether the backend answered a probe, and the timeout in force. It never
# returns a key or a base URL.

# ── Ollama (EXTRACTION_PROVIDER=ollama) ──────────────────────────────────────
# The offline-safe option, and the one to use at a venue. It runs on the
# presenting machine and needs no internet at all:
#     ollama serve
#     ollama pull qwen3:8b
# If Ollama is unreachable or the model is not pulled, make_backend_from_env
# logs a warning and falls back to rules-only. Nothing breaks and the
# supervisor sees no error.
OLLAMA_MODEL=qwen3:8b
OLLAMA_BASE_URL=http://localhost:11434
# Greedy decoding: extraction is not a creative task.
OLLAMA_TEMPERATURE=0
# qwen3 is a hybrid reasoning model. Leave thinking OFF: the think block
# breaks structured output and adds latency for no accuracy gain here.
OLLAMA_THINK=false
OLLAMA_TIMEOUT=120
OLLAMA_NUM_CTX=8192

# ── OpenAI-compatible (EXTRACTION_PROVIDER=openai) ───────────────────────────
# Any OpenAI-compatible endpoint: OpenAI itself, a gateway, or a self-hosted
# server that speaks /v1/chat/completions.
#
# WARNING — this path needs outbound internet. Conference and venue networks
# frequently block it, and a demo that depends on it can fail for reasons that
# have nothing to do with the product. Use Ollama on the presenting machine
# instead. If you do use this path, rehearse the fallback: unset
# EXTRACTION_PROVIDER and confirm the demo is unchanged.
#
# Placeholders only. Never commit a real key; never paste one into
# .env.example. Put the real value in .env, which is gitignored.
# OPENAI_API_KEY=sk-replace-me
# OPENAI_MODEL=gpt-4o-mini
# OPENAI_BASE_URL=https://api.openai.com/v1
# OPENAI_TEMPERATURE=0

# ── Agent-turn timeout ───────────────────────────────────────────────────────
# How long one conversational turn will wait for the model before giving up and
# answering from the deterministic parsers. Deliberately far shorter than
# OLLAMA_TIMEOUT above, which bounds the batch ingest path: a supervisor is
# holding a phone, and the rules path can answer immediately. Default 5s.
# NAVIS_LLM_TIMEOUT_SECONDS=5

# ── Demo reset route ─────────────────────────────────────────────────────────
# POST /admin/reset answers 404 unless this is set. See DEMO.md.
# NAVIS_ENABLE_RESET=1
